<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{6B2C7A41-9E2D-4C77-8B2E-2F0F5E1A9D10}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>Lab4Camera</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!--
    ВАЖНО: OpenCV. По умолчанию берётся из переменной окружения OPENCV_DIR
    (обычно C:\opencv\build). Если версия OpenCV не 4.10, поправьте
    OpenCvVersion ниже: 4.8 -> 480, 4.9 -> 490, 4.10 -> 4100 и т.д.
  -->
  <PropertyGroup Label="OpenCV">
    <!--
      Порядок выбора значения (первое найденное побеждает):
        1) свойство, переданное при сборке:  msbuild /p:OpenCvVersion=4100
        2) свойство из Property Sheet (.props) или из системных переменных
        3) ОБЫЧНАЯ СИСТЕМНАЯ ПЕРЕМЕННАЯ окружения OPENCV_DIR / OPENCV_VERSION
        4) значения по умолчанию ниже
      ВНИМАНИЕ: эти два свойства НЕ видны в окне «Свойства проекта» —
      это пользовательские свойства MSBuild, их правят в тексте проекта
      либо в отдельном .props-файле (см. README, раздел 3.1).
    -->
    <OpenCvDir Condition="'$(OPENCV_DIR)' != ''">$(OPENCV_DIR)</OpenCvDir>
    <OpenCvDir Condition="'$(OpenCvDir)' == ''">C:\opencv\build</OpenCvDir>

    <OpenCvVersion Condition="'$(OPENCV_VERSION)' != ''">$(OPENCV_VERSION)</OpenCvVersion>
    <OpenCvVersion Condition="'$(OpenCvVersion)' == ''">4120</OpenCvVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>Lab4_Camera</TargetName>
    <EnableDpiAwareness>PerMonitorHighDPIAware</EnableDpiAwareness>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(OpenCvDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- /utf-8: исходник сохранён в UTF-8 и содержит кириллицу в строках -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OpenCvDir)\x64\vc17\lib;$(OpenCvDir)\x64\vc16\lib;$(OpenCvDir)\x64\vc15\lib;$(OpenCvDir)\x64\vc14\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>comctl32.lib;shell32.lib;user32.lib;gdi32.lib;advapi32.lib;ole32.lib;oleaut32.lib;uuid.lib;strmiids.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <Culture>0x0419</Culture>
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <PostBuildEvent>
      <Command>if exist "$(OpenCvDir)\x64\vc17\bin\*.dll" copy /Y "$(OpenCvDir)\x64\vc17\bin\*.dll" "$(OutDir)" &gt;nul
if exist "$(OpenCvDir)\x64\vc16\bin\*.dll" copy /Y "$(OpenCvDir)\x64\vc16\bin\*.dll" "$(OutDir)" &gt;nul</Command>
      <Message>Копирование DLL OpenCV рядом с exe</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <AdditionalDependencies>opencv_world$(OpenCvVersion)d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>opencv_world$(OpenCvVersion).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="visual.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="visual.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="app.rc" />
  </ItemGroup>
  <ItemGroup>
    <Image Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" />
  </ItemGroup>

  <!--
    Диагностика: печатает в окно сборки, какие пути и версия используются,
    и предупреждает, если нужного opencv_world*.lib нет на месте.
    Если OpenCV установлен в другое место — правьте OpenCvDir/OpenCvVersion.
  -->
  <Target Name="CheckOpenCv" BeforeTargets="PrepareForBuild">
    <Message Importance="high" Text="OpenCV: каталог = $(OpenCvDir), версия библиотеки = opencv_world$(OpenCvVersion).lib" />
    <Warning Condition="!Exists('$(OpenCvDir)\x64\vc17\lib\opencv_world$(OpenCvVersion).lib') and !Exists('$(OpenCvDir)\x64\vc16\lib\opencv_world$(OpenCvVersion).lib') and !Exists('$(OpenCvDir)\x64\vc15\lib\opencv_world$(OpenCvVersion).lib') and !Exists('$(OpenCvDir)\x64\vc14\lib\opencv_world$(OpenCvVersion).lib')"
             Text="Не найден opencv_world$(OpenCvVersion).lib в '$(OpenCvDir)\x64\vc*\lib'. Проверьте путь OPENCV_DIR и свойство OpenCvVersion (4.10 -&gt; 4100, 4.12 -&gt; 4120, 5.0 -&gt; 5000)." />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
